import { ListView } from "std-widgets.slint";

export component App inherits Window {
    title: "Elsewhere";
    preferred-width: 360px;
    preferred-height: 640px;

    in property <[string]> categories;

    VerticalLayout {
        padding: 12px;

        ListView {
            for name in root.categories: Text {
                text: name;
            }
        }
    }
}

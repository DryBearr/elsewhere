import { Button, LineEdit, ListView } from "std-widgets.slint";

export component App inherits Window {
    title: "Elsewhere";
    preferred-width: 360px;
    preferred-height: 640px;

    in property <[string]> categories;

    // "Try yt-dlp": paste a link, get its title. Shows that yt-dlp works on this device.
    in property <string> ytdlp-status;
    in property <bool> ytdlp-ready;
    in property <bool> ytdlp-busy;
    in property <string> ytdlp-result;
    callback ytdlp-info(string);

    VerticalLayout {
        // Keep clear of the status bar, notch and gesture bar on phones.
        padding-top: max(12px, root.safe-area-insets.top);
        padding-bottom: max(12px, root.safe-area-insets.bottom);
        padding-left: max(12px, root.safe-area-insets.left);
        padding-right: max(12px, root.safe-area-insets.right);
        spacing: 8px;

        Text {
            text: root.ytdlp-status;
            wrap: word-wrap;
        }

        link := LineEdit {
            placeholder-text: "Paste a video link";
            enabled: root.ytdlp-ready;
            accepted => {
                if (root.ytdlp-ready && !root.ytdlp-busy && self.text != "") {
                    root.ytdlp-info(self.text);
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            // Slint's long-press menu (with Paste) exists only on Android, so phones
            // without it, like the iPhone, need a button.
            Button {
                text: "Paste";
                enabled: root.ytdlp-ready;
                clicked => {
                    link.text = "";
                    link.paste();
                }
            }

            Button {
                text: "Get info";
                enabled: root.ytdlp-ready && !root.ytdlp-busy && link.text != "";
                clicked => {
                    root.ytdlp-info(link.text);
                }
            }
        }

        Text {
            text: root.ytdlp-result;
            wrap: word-wrap;
        }

        ListView {
            for name in root.categories: Text {
                text: name;
            }
        }
    }
}
